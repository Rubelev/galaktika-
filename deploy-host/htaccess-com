DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/auth/([a-zA-Z]+)/?$ api.php?action=$1 [L,QSA]
    RewriteRule ^api/pay/([a-zA-Z]+)/?$ api.php?action=pay_$1 [L,QSA]
    RewriteRule ^api/health/?$ api.php?action=health [L,QSA]
</IfModule>

<FilesMatch "^(users|tokens|pay-orders|pay-settings)\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<script>
// Страховка: если скрипты не загрузились (кеш, блокировщик, старый браузер) — показываем понятное сообщение
(function () {
    window.__booted = false;
    setTimeout(function () {
        if (window.__booted) return;
        var box = document.createElement('div');
        box.id = 'boot-fail';
        box.style.cssText = 'position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;'
            + 'background:#050d18;color:#dce8f7;font:14px/1.5 system-ui,sans-serif;padding:20px;text-align:center';
        box.innerHTML = '<div style="max-width:min(420px,92vw)">'
            + '<div style="font-size:20px;font-weight:700;color:#8fd0ff;margin-bottom:10px;">Игра не загрузилась</div>'
            + '<div style="opacity:.8;margin-bottom:14px;">Похоже, браузер держит старые файлы в кеше '
            + 'или их блокирует расширение.</div>'
            + '<button onclick="location.replace(location.pathname + \'?r=\' + Date.now())" '
            + 'style="padding:12px 20px;border-radius:12px;border:none;background:#2ecc71;color:#04121f;'
            + 'font-weight:700;font-size:15px;cursor:pointer;">Обновить игру</button>'
            + '<div style="opacity:.55;margin-top:12px;font-size:12px;">На компьютере: Ctrl+F5. '
            + 'Если не помогло — отключите блокировщик для этого сайта.</div>'
            + '</div>';
        var boots = window.__booted
            || document.querySelector('#auth-overlay')
            || document.getElementById('left-menu-items');
        if (boots) return;
        document.body.appendChild(box);
    }, 7000);
})();
</script>

    <link rel="stylesheet" href="app.css?v=@DateTime.Now.Ticks" />
    <HeadOutlet />
    <script>
        // Редирект на https: Apache за nginx не видит протокол, поэтому делаем на клиенте.
        // Только для домена с валидным сертификатом — у .store его пока нет.
        (function () {
            if (location.protocol !== 'http:') return;
            if (!/(^|\.)warbattleuniverse\.com$/i.test(location.hostname)) return;
            location.replace('https://' + location.host + location.pathname + location.search);
        })();
    </script></head>

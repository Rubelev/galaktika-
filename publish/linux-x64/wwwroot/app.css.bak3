body, html { background-color: #000 !important; margin: 0; padding: 0; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
.page { display: block !important; } .sidebar { display: none !important; } .top-row { display: none !important; } .content { padding: 0 !important; margin: 0 !important; width: 100vw !important; height: 100vh !important; overflow: hidden; }

/* ЛЕГЕНДА */
.legend-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: radial-gradient(circle at center, #0a0f1e 0%, #000 100%); z-index: 999999; display: none; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; }
.legend-content { position: relative; width: 90%; max-width: 900px; height: 60vh; }
.legend-slide { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; opacity: 0; transform: translateY(30px) scale(0.95); transition: opacity 1.5s ease, transform 1.5s ease; }
.legend-slide.active { opacity: 1; transform: translateY(0) scale(1); }
.slide-year { font-size: 120px; font-weight: 100; color: #8ab4f8; letter-spacing: 10px; opacity: 0.6; margin-bottom: 20px; text-shadow: 0 0 30px rgba(138, 180, 248, 0.3); }
.slide-title { font-size: 42px; font-weight: 300; color: #fff; margin-bottom: 20px; letter-spacing: 2px; text-shadow: 0 0 20px rgba(255,255,255,0.2); }
.slide-subtitle { font-size: 18px; color: #888; margin-bottom: 30px; letter-spacing: 4px; text-transform: uppercase; }
.slide-text { font-size: 20px; color: #ccc; line-height: 1.6; max-width: 700px; }
.legend-progress { position: absolute; bottom: 80px; left: 50%; transform: translateX(-50%); width: 60%; max-width: 600px; height: 3px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; }
.legend-progress-bar { height: 100%; width: 0%; background: linear-gradient(90deg, #3b82f6, #8ab4f8); box-shadow: 0 0 10px rgba(59, 130, 246, 0.5); }
.legend-skip { position: absolute; bottom: 30px; right: 40px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); color: #aaa; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px; transition: 0.3s; }
.legend-skip:hover { background: rgba(255,255,255,0.15); color: #fff; }

/* АВТОРИЗАЦИЯ */
.auth-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.9); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; z-index: 99999; }
.auth-container { background: rgba(15, 25, 45, 0.9); padding: 30px; border-radius: 20px; border: 1px solid rgba(100, 150, 255, 0.4); box-shadow: 0 0 30px rgba(100, 150, 255, 0.2); text-align: center; width: 400px; color: #fff; max-height: 95vh; overflow-y: auto; }
.auth-container.register-container { width: 500px; }
.auth-title { font-size: 22px; font-weight: 300; letter-spacing: 1px; margin-bottom: 30px; color: #8ab4f8; text-transform: uppercase; line-height: 1.4; }
.btn-large-green { background: #2ecc71; color: #fff; border: none; padding: 15px 30px; font-size: 16px; border-radius: 10px; cursor: pointer; width: 100%; font-weight: bold; box-shadow: 0 5px 15px rgba(46, 204, 113, 0.4); transition: 0.3s; margin-bottom: 12px; }
.btn-large-green:hover { background: #27ae60; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(46, 204, 113, 0.6); }
.btn-large-blue { background: #3b82f6; color: #fff; border: none; padding: 15px 30px; font-size: 16px; border-radius: 10px; cursor: pointer; width: 100%; font-weight: bold; box-shadow: 0 5px 15px rgba(59, 130, 246, 0.4); transition: 0.3s; margin-bottom: 15px; }
.btn-large-blue:hover { background: #2563eb; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(59, 130, 246, 0.6); }
.auth-hint { font-size: 12px; color: #888; margin-top: 15px; line-height: 1.5; }
.auth-input { width: 100%; padding: 12px; margin-bottom: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.3); color: #fff; font-size: 14px; box-sizing: border-box; outline: none; }
.auth-input:focus { border-color: #3b82f6; }
.auth-btn { background: #3b82f6; color: #fff; border: none; padding: 12px; border-radius: 8px; width: 100%; cursor: pointer; font-size: 14px; margin-bottom: 10px; transition: 0.2s; font-weight: bold; margin-top: 10px; }
.auth-btn:hover { background: #60a5fa; }
.auth-link-btn { background: transparent; color: #8ab4f8; border: 1px solid rgba(138, 180, 248, 0.3); padding: 8px; border-radius: 6px; width: 100%; cursor: pointer; font-size: 13px; transition: 0.2s; }
.auth-link-btn:hover { background: rgba(138, 180, 248, 0.1); color: #fff; }

/* КАРТОЧКИ ФРАКЦИЙ */
.faction-selector { margin: 15px 0; } .faction-label { font-size: 13px; color: #8ab4f8; margin-bottom: 10px; text-align: left; padding-left: 5px; }
.faction-cards { display: flex; gap: 8px; justify-content: space-between; }
.faction-card { flex: 1; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 12px 5px; cursor: pointer; transition: all 0.3s; text-align: center; }
.faction-card:hover { background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.5); transform: translateY(-3px); }
.faction-card.selected { background: rgba(46, 204, 113, 0.2); border-color: #2ecc71; box-shadow: 0 0 15px rgba(46, 204, 113, 0.4); transform: translateY(-3px); }
.faction-icon { font-size: 28px; margin-bottom: 5px; } .faction-name { font-size: 12px; font-weight: bold; color: #fff; margin-bottom: 3px; line-height: 1.2; } .faction-desc { font-size: 10px; color: #888; line-height: 1.2; }

/* МЕНЮ */
.left-menu { position: fixed; top: 50%; left: 0; transform: translateY(-50%); z-index: 10000; display: flex; flex-direction: column; gap: 10px; background: rgba(15, 25, 45, 0.85); border: 1px solid rgba(100, 150, 255, 0.3); border-left: none; border-radius: 0 16px 16px 0; padding: 15px; transition: transform 0.3s ease; }
.left-menu.collapsed { transform: translate(-100%, -50%); }
.menu-toggle { position: absolute; right: -35px; top: 50%; transform: translateY(-50%); width: 35px; height: 50px; background: rgba(15, 25, 45, 0.9); border: 1px solid rgba(100, 150, 255, 0.3); border-left: none; border-radius: 0 10px 10px 0; color: #fff; cursor: pointer; font-size: 18px; }
.menu-items { display: flex; flex-direction: column; gap: 10px; }
.menu-btn { padding: 10px 20px; background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer; font-size: 14px; text-align: left; transition: 0.2s; }
.menu-btn:hover { background: rgba(59, 130, 246, 0.4); }
.chat-panel, .resources-panel { display: none; flex-direction: column; width: 250px; height: 400px; }
.chat-header { display: flex; justify-content: space-between; align-items: center; color: #fff; margin-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; }
.back-btn { background: none; border: none; color: #3b82f6; cursor: pointer; font-size: 14px; }
.chat-messages { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding-right: 5px; }
.chat-msg { background: rgba(255,255,255,0.1); padding: 8px 12px; border-radius: 8px; color: #fff; font-size: 13px; max-width: 90%; word-wrap: break-word; }
.my-msg { background: rgba(59, 130, 246, 0.4); align-self: flex-end; border-bottom-right-radius: 0; }
.chat-input-area { display: flex; gap: 5px; margin-top: 10px; }
.chat-input-area input { flex: 1; padding: 8px; border-radius: 6px; border: none; background: rgba(255,255,255,0.1); color: #fff; outline: none; }
.chat-input-area button { background: #3b82f6; border: none; border-radius: 6px; color: #fff; padding: 8px 12px; cursor: pointer; }
.resources-list { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
.resource-item { display: flex; align-items: center; background: rgba(255,255,255,0.05); padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); }
.resource-icon { font-size: 24px; margin-right: 12px; } .resource-details { display: flex; flex-direction: column; }
.resource-name { font-size: 12px; color: #8ab4f8; } .resource-amount { font-size: 16px; font-weight: bold; color: #fff; } .resource-unit { font-size: 11px; color: #888; font-weight: normal; }

/* МОДАЛКИ */
.admin-modal, .fleet-modal, .quest-modal, .codex-modal { position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); display: none; align-items: center; justify-content: center; z-index: 100001; }
.admin-modal-content { background: rgba(15, 25, 45, 0.95); padding: 30px; border-radius: 16px; border: 1px solid rgba(100, 150, 255, 0.4); width: 450px; color: #fff; position: relative; }
.fleet-modal-content { background: rgba(15, 25, 45, 0.98); padding: 30px; border-radius: 16px; border: 1px solid rgba(100, 150, 255, 0.4); width: 900px; max-height: 90vh; overflow-y: auto; color: #fff; position: relative; }
.quest-modal-content { background: rgba(15, 25, 45, 0.98); padding: 30px; border-radius: 16px; border: 1px solid rgba(100, 150, 255, 0.4); width: 650px; max-height: 90vh; overflow-y: auto; color: #fff; position: relative; }
.codex-modal-content { background: rgba(15, 25, 45, 0.98); padding: 30px; border-radius: 16px; border: 1px solid rgba(100, 150, 255, 0.4); width: 750px; max-height: 90vh; overflow-y: auto; color: #fff; position: relative; box-shadow: 0 0 50px rgba(100, 150, 255, 0.3); }
.close-btn { position: absolute; top: 15px; right: 20px; font-size: 24px; cursor: pointer; color: #ff6b6b; }

/* АДМИНКА */
.user-list-modal { list-style: none; padding: 0; margin-top: 20px; max-height: 400px; overflow-y: auto; }
.user-list-modal li { padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.user-list-modal li b { color: #fff; font-size: 14px; }

/* ФЛОТ */
.fleet-body { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-top: 20px; }
.fleet-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 15px; transition: 0.3s; }
.fleet-card:hover { background: rgba(255,255,255,0.06); transform: translateY(-2px); }
.fleet-card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; padding: 10px; border-radius: 8px; }
.fleet-icon { font-size: 32px; } .fleet-class { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; } .fleet-name { font-size: 18px; font-weight: bold; color: #fff; margin-top: 2px; }
.fleet-desc { font-size: 13px; color: #aaa; line-height: 1.5; margin-bottom: 10px; }
.fleet-stats { font-size: 12px; color: #8ab4f8; margin-bottom: 10px; padding: 6px 10px; background: rgba(59, 130, 246, 0.1); border-radius: 6px; }
.fleet-count { display: flex; justify-content: space-between; align-items: center; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); }
.fleet-count b { font-size: 22px; color: #fff; }
.fleet-card.colonizer-card { grid-column: span 2; background: linear-gradient(135deg, rgba(0, 229, 255, 0.15), rgba(15, 25, 45, 0.9)); border: 1px solid rgba(0, 229, 255, 0.6); box-shadow: 0 0 20px rgba(0, 229, 255, 0.2); position: relative; overflow: hidden; }
.fleet-card.colonizer-card::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(0, 229, 255, 0.1) 0%, transparent 60%); animation: rotateColonizer 10s linear infinite; pointer-events: none; }
@keyframes rotateColonizer { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.fleet-card.colonizer-card .fleet-icon { font-size: 54px; filter: drop-shadow(0 0 10px rgba(0, 229, 255, 0.8)); }
.fleet-card.colonizer-card .fleet-name { font-size: 22px; color: #00e5ff; text-shadow: 0 0 10px rgba(0, 229, 255, 0.5); }
.fleet-card.colonizer-card .fleet-desc { color: #b0e0e6; font-size: 14px; }
.fleet-card.colonizer-card .fleet-stats { background: rgba(0, 229, 255, 0.15); color: #00e5ff; }

/* КВЕСТЫ */
.quest-header { margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; }
.quest-header h3 { font-size: 24px; color: #8ab4f8; font-weight: 300; margin-bottom: 10px; }
.quest-header p { color: #ccc; line-height: 1.6; font-size: 14px; }
.quest-steps { display: flex; flex-direction: column; gap: 15px; }
.quest-step { display: flex; align-items: center; gap: 15px; padding: 15px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; transition: 0.3s; }
.quest-step.completed { opacity: 0.5; border-color: rgba(46, 204, 113, 0.3); background: rgba(46, 204, 113, 0.05); }
.quest-step.active { border-color: #3b82f6; background: rgba(59, 130, 246, 0.1); box-shadow: 0 0 15px rgba(59, 130, 246, 0.2); }
.step-num { width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-weight: bold; color: #fff; }
.quest-step.completed .step-num { background: #2ecc71; } .quest-step.active .step-num { background: #3b82f6; }
.step-info { flex: 1; } .step-info b { color: #fff; font-size: 15px; } .step-info i { color: #8ab4f8; font-style: normal; }
.step-cost { font-size: 12px; color: #888; margin-top: 5px; }
.quest-reward { margin-top: 20px; padding: 20px; background: rgba(46, 204, 113, 0.1); border: 1px dashed #2ecc71; border-radius: 10px; text-align: center; }
.quest-reward h3 { color: #2ecc71; margin-bottom: 10px; } .quest-reward p { color: #fff; font-size: 15px; }

/* СПРАВОЧНИК */
.codex-tabs { display: flex; gap: 8px; margin: 20px 0; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; flex-wrap: wrap; }
.codex-tab { flex: 1; min-width: 100px; padding: 10px 15px; background: rgba(255,255,255,0.05); color: #aaa; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer; font-size: 13px; transition: 0.2s; font-family: inherit; }
.codex-tab:hover { background: rgba(59, 130, 246, 0.3); color: #fff; }
.codex-tab.active { background: rgba(59, 130, 246, 0.5); color: #fff; border-color: #3b82f6; }
.codex-header { text-align: center; padding-bottom: 20px; border-bottom: 2px solid; margin-bottom: 20px; }
.codex-title { font-size: 32px; font-weight: 300; letter-spacing: 2px; margin-bottom: 5px; }
.codex-subtitle { font-size: 14px; color: #888; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 10px; }
.codex-tagline { font-size: 16px; color: #ccc; font-style: italic; }
.codex-section { margin-bottom: 20px; } .codex-section h3 { font-size: 18px; margin-bottom: 10px; color: #8ab4f8; font-weight: 400; } .codex-section p { line-height: 1.7; color: #ccc; }
.codex-economy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
.codex-economy-card { background: rgba(0,0,0,0.3); padding: 15px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); }
.codex-economy-card h3 { margin-bottom: 10px; } .codex-economy-card ul { list-style: none; padding: 0; margin: 0; }
.codex-economy-card ul li { padding: 5px 0; padding-left: 20px; position: relative; color: #ddd; font-size: 14px; }
.codex-economy-card.deficit ul li::before { content: "✖"; position: absolute; left: 0; color: #ff6b6b; }
.codex-economy-card.surplus ul li::before { content: "✓"; position: absolute; left: 0; color: #2ecc71; }
.codex-trade { background: rgba(59, 130, 246, 0.1); padding: 15px; border-radius: 10px; border: 1px solid rgba(59, 130, 246, 0.3); }
.codex-trade div { padding: 5px 0; font-size: 14px; } .codex-trade b { color: #8ab4f8; }
.codex-quote { background: rgba(0,0,0,0.3); padding: 15px 20px; border-left: 4px solid; font-style: italic; color: #ddd; font-size: 15px; border-radius: 0 10px 10px 0; }

/* ПРАВАЯ ПАНЕЛЬ */
.control-panel { position: fixed; top: 20px; right: 20px; z-index: 10000; width: 260px; background: rgba(15, 25, 45, 0.75); backdrop-filter: blur(15px); border: 1px solid rgba(100, 150, 255, 0.3); border-radius: 16px; padding: 15px; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.6), 0 0 15px rgba(100, 150, 255, 0.1); }
.datetime-box { text-align: right; color: #fff; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); }
.datetime-date { font-size: 14px; color: #8ab4f8; text-transform: capitalize; letter-spacing: 1px; } .datetime-time { font-size: 28px; font-weight: 300; color: #fff; margin-top: 2px; }
.title { margin-top: 8px; font-weight: 400; letter-spacing: 1px; color: #fff; text-transform: uppercase; font-size: 16px; }
.time-control { display: flex; flex-direction: column; gap: 8px; color: #aaa; font-size: 13px; background: rgba(0,0,0,0.3); padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); }
.time-control input { width: 70px; padding: 6px; border-radius: 6px; border: 1px solid #555; background: rgba(255,255,255,0.1); color: #fff; text-align: center; font-size: 13px; }
.action-btn { border: none; padding: 6px 10px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: 0.2s; font-family: inherit; }
.apply-btn { background: #3b82f6; color: #fff; } .apply-btn:hover { background: #60a5fa; }
.reset-btn { background: rgba(255, 255, 255, 0.15); color: #fff; } .reset-btn:hover { background: rgba(255, 255, 255, 0.3); }
.mode-btn { flex: 1; background: rgba(255,255,255,0.1); border: 1px solid #555; color: #fff; padding: 4px 0; border-radius: 4px; cursor: pointer; font-size: 11px; transition: 0.2s; }
.mode-btn:hover { background: rgba(59, 130, 246, 0.4); border-color: #3b82f6; }
.nav-controls { display: flex; gap: 15px; justify-content: space-between; align-items: center; padding-top: 5px; }
.d-pad { display: grid; grid-template-columns: 35px 35px 35px; grid-template-rows: 35px 35px 35px; gap: 4px; }
.d-btn { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px; color: #fff; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
.d-btn:hover { background: rgba(59, 130, 246, 0.5); }
.d-btn.up { grid-column: 2; grid-row: 1; } .d-btn.left { grid-column: 1; grid-row: 2; } .d-btn.center { grid-column: 2; grid-row: 2; font-size: 20px; color: #888; } .d-btn.right { grid-column: 3; grid-row: 2; } .d-btn.down { grid-column: 2; grid-row: 3; }
.zoom-controls { display: flex; flex-direction: column; gap: 10px; flex: 1; }
.tilt-row { display: flex; width: 100%; } .tilt-row input { width: 100%; cursor: pointer; accent-color: #3b82f6; }
.zoom-row { display: flex; gap: 5px; justify-content: space-between; }
.zoom-btn { flex: 1; height: 35px; border-radius: 6px; border: none; background: rgba(255, 255, 255, 0.1); color: #fff; font-size: 16px; transition: background 0.2s; font-family: inherit; display: flex; align-items: center; justify-content: center; }
button.zoom-btn { cursor: pointer; } button.zoom-btn:hover { background: rgba(59, 130, 246, 0.5); }
.zoom-text { font-size: 12px; color: #8ab4f8; cursor: default; background: transparent; border: 1px solid rgba(255,255,255,0.1); }

/* КОСМОС */
.solar-system-container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; width: 100vw; background: #000; position: fixed; top: 0; left: 0; z-index: 9999; cursor: grab; overflow: hidden; touch-action: none; user-select: none; perspective: 1500px; }
.solar-system { position: relative; width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; transform-style: preserve-3d; z-index: 2; transition: transform 0.1s ease-out; }
#starfield-canvas { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 0; pointer-events: none; }
#asteroid-canvas { position: absolute; top: 50%; left: 50%; width: 2000px; height: 2000px; transform: translate(-50%, -50%); pointer-events: none; z-index: 1; opacity: 0.5; filter: blur(0.6px); }

/* ФИКС: Возвращаем Солнцу центр */
.sun { width: 110px; height: 110px; background: radial-gradient(circle at 30% 30%, #fffde7, #ffeb3b 30%, #f57c00 80%, #d84315); border-radius: 50%; box-shadow: 0 0 60px #ff9800, 0 0 150px #ff5722; position: absolute; z-index: 10; top: 50%; left: 50%; transform: translate(-50%, -50%) rotateZ(calc(-1 * var(--rot-z, 0deg))) rotateX(calc(-1 * var(--rot-x, 0deg))); }

.orbit { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 50%; transform-style: preserve-3d; }
.planet-wrapper { position: absolute; top: 50%; left: 50%; width: 0; height: 0; transform-style: preserve-3d; }
.planet { position: absolute; top: 0; left: 0; transform: translate(-50%, -50%); border-radius: 50%; z-index: 2; transform-style: preserve-3d; }
.planet-surface { position: absolute; inset: 0; border-radius: 50%; background-size: 200% 100%; background-repeat: repeat-x; background-position: center; transform: rotateZ(calc(-1 * var(--rot-z, 0deg))) rotateX(calc(-1 * var(--rot-x, 0deg))); filter: brightness(1.5) contrast(1.1); }
.planet-shadow { position: absolute; inset: 0; border-radius: 50%; z-index: 3; pointer-events: none; transform: rotateZ(calc(-1 * var(--rot-z, 0deg))) rotateX(calc(-1 * var(--rot-x, 0deg))); }
.earth .planet-surface { position: absolute; inset: 0; border-radius: 50%; background-size: 200% 100%; background-repeat: repeat-x; background-position: center; transform: rotateZ(calc(-1 * var(--rot-z, 0deg))) rotateX(calc(-1 * var(--rot-x, 0deg))); filter: brightness(1.5) contrast(1.1); }
.mars .planet-surface { position: absolute; inset: 0; border-radius: 50%; background-size: 200% 100%; background-repeat: repeat-x; background-position: center; transform: rotateZ(calc(-1 * var(--rot-z, 0deg))) rotateX(calc(-1 * var(--rot-x, 0deg))); filter: brightness(1.5) contrast(1.1); }
.jupiter .planet-surface { position: absolute; inset: 0; border-radius: 50%; background-size: 200% 100%; background-repeat: repeat-x; background-position: center; transform: rotateZ(calc(-1 * var(--rot-z, 0deg))) rotateX(calc(-1 * var(--rot-x, 0deg))); filter: brightness(1.5) contrast(1.1); }
.saturn .planet-surface { position: absolute; inset: 0; border-radius: 50%; background-size: 200% 100%; background-repeat: repeat-x; background-position: center; transform: rotateZ(calc(-1 * var(--rot-z, 0deg))) rotateX(calc(-1 * var(--rot-x, 0deg))); filter: brightness(1.5) contrast(1.1); }
.earth-orbit { width: 360px; height: 360px; } .earth { width: 26px; height: 26px; }
.mars-orbit { width: 460px; height: 460px; } .mars { width: 20px; height: 20px; }
.jupiter-orbit { width: 600px; height: 600px; } .jupiter { width: 54px; height: 54px; }
.saturn-orbit { width: 760px; height: 760px; } .saturn { width: 48px; height: 48px; }
.saturn::before { content: ''; position: absolute; top: 50%; left: 50%; width: 200%; height: 200%; border-radius: 50%; box-shadow: 0 0 0 2px rgba(210, 180, 140, 0.7), 0 0 0 5px rgba(0, 0, 0, 0.4), 0 0 0 7px rgba(210, 180, 140, 0.4), 0 0 0 11px rgba(210, 180, 140, 0.15); transform: translate(-50%, -50%) rotateZ(-20deg) rotateX(75deg); z-index: -1; pointer-events: none; }
.moon-system { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); transform-style: preserve-3d; pointer-events: none; }
.moon-orbit { position: absolute; top: 50%; left: 50%; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.05); transform-style: preserve-3d; }
.moon { position: absolute; top: 50%; left: 50%; border-radius: 50%; background-size: cover; background-position: center; z-index: 1; aspect-ratio: 1 / 1; overflow: hidden; transform-style: preserve-3d; }
.moon-shadow { position: absolute; inset: 0; border-radius: 50%; z-index: 3; pointer-events: none; }
.tooltip { position: absolute; top: -30px; left: 50%; transform: translateX(-50%); background: rgba(15, 25, 45, 0.95); color: #fff; padding: 4px 10px; border-radius: 6px; font-family: 'Segoe UI', sans-serif; font-size: 12px; font-weight: 500; white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity 0.2s ease, transform 0.2s ease; border: 1px solid rgba(100, 150, 255, 0.5); backdrop-filter: blur(4px); box-shadow: 0 4px 10px rgba(0,0,0,0.5); z-index: 100; }
.tooltip::after { content: ''; position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%) rotate(45deg); width: 8px; height: 8px; background: rgba(15, 25, 45, 0.95); border-right: 1px solid rgba(100, 150, 255, 0.5); border-bottom: 1px solid rgba(100, 150, 255, 0.5); }
.planet:hover .tooltip, .moon:hover .tooltip, .sun:hover .tooltip { opacity: 1; transform: translateX(-50%) translateY(-5px); }

/* ПОРТАЛ */
.portal { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) translateX(-1600px) translateY(-200px); width: 200px; height: 200px; z-index: 5; pointer-events: none; animation: portalFloat 8s ease-in-out infinite; }
@keyframes portalFloat { 0%, 100% { transform: translate(-50%, -50%) translateX(-1600px) translateY(-200px); } 50% { transform: translate(-50%, -50%) translateX(-1600px) translateY(-230px); } }
.portal-ring { position: absolute; top: 50%; left: 50%; border-radius: 50%; transform: translate(-50%, -50%); border: 2px solid rgba(0, 229, 255, 0.8); box-shadow: 0 0 30px rgba(0, 229, 255, 0.6), inset 0 0 30px rgba(0, 229, 255, 0.4); }
.portal-ring.outer { width: 200px; height: 200px; animation: portalRotate 20s linear infinite; border-style: dashed; border-color: rgba(0, 229, 255, 0.5); }
.portal-ring.inner { width: 140px; height: 140px; animation: portalRotateReverse 15s linear infinite; border-color: rgba(138, 180, 248, 0.8); box-shadow: 0 0 40px rgba(138, 180, 248, 0.7), inset 0 0 40px rgba(138, 180, 248, 0.5); }
.portal-core { position: absolute; top: 50%; left: 50%; width: 100px; height: 100px; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(0, 229, 255, 0.4) 0%, rgba(59, 130, 246, 0.2) 40%, transparent 70%); animation: portalPulse 3s ease-in-out infinite; }
@keyframes portalRotate { from { transform: translate(-50%, -50%) rotate(0deg); } to { transform: translate(-50%, -50%) rotate(360deg); } }
@keyframes portalRotateReverse { from { transform: translate(-50%, -50%) rotate(360deg); } to { transform: translate(-50%, -50%) rotate(0deg); } }
@keyframes portalPulse { 0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); } }
.portal .tooltip { top: -30px; left: 50%; transform: translateX(-50%); color: #00e5ff; border-color: rgba(0, 229, 255, 0.5); }
.portal:hover .tooltip { opacity: 1; }





